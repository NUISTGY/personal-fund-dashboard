{
  "name": "financial-dashboard",
  "version": "1.0.6",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start:app": "vite --host 127.0.0.1 --port 5176 --strictPort",
    "build": "vite build",
    "build:android": "CAPACITOR_BUILD=true vite build && npx cap sync android",
    "android:apk": "npm run build:android && cd android && ./gradlew assembleRelease",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "echarts": "^5.6.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@vitejs/plugin-react": "^4.5.0",
    "vite": "^5.4.11"
  }
}
